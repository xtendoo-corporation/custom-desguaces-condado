    <!-- List view for product.vehicle -->
    <record id="product_vehicle_list_view" model="ir.ui.view">
        <field name="name">product.vehicle.list</field>
        <field name="model">product.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="products_count"/>
                <field name="website_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- List view for product.vehicle.image -->
    <record id="view_product_vehicle_image_list" model="ir.ui.view">
        <field name="name">product.vehicle.image.list</field>
        <field name="model">product.vehicle.image</field>
        <field name="arch" type="xml">
            <list string="Vehicle Images">
                <!-- Use the 'image' field to display the image -->
                <field name="image" widget="image" options="{'preview_image': 'image'}" width="100"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- This view is used to create and edit vehicle records -->
    <record id="product_vehicle_form_view" model="ir.ui.view">
        <field name="name">product.vehicle.form</field>
        <field name="model">product.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle Products">
                <sheet>
                    <!-- Group with basic fields -->
                    <group>
                        <field name="name" placeholder="Ingrese el nombre del vehículo"/>
                        <field name="description"/>
                    </group>
                    <!-- Group with additional information -->
                    <group>
                        <field name="is_published" widget="boolean_toggle"/>
                        <field name="products_count" readonly="1"/>
                    </group>
                    <!-- Notebook is used to group related fields into tabs -->
                    <notebook>
                        <page string="Imágenes">
                            <!-- Reference the previously defined list view to display images in 'list,form' mode -->
                            <field name="image_ids">
                                <list view_id="view_product_vehicle_image_list"/>
                            </field>
                        </page>
                        <page string="Productos Relacionados">
                            <field name="product_ids" mode="list,form"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <!-- Window action to open the vehicle list -->
    <record id="action_product_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicle</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu item for the vehicle -->
    <menuitem id="menu_product_vehicle"
              name="Vehicles"
              action="desguace_website_sale_product_vehicle.action_product_vehicle"
              parent="stock.menu_stock_inventory_control"
              sequence="200"
    />
</odoo>
