<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Template for the vehicle list page -->
    <template id="vehicle_list_template" name="Product Vehicles">
        <t t-call="website.layout">
            <t t-set="additional_title">Vehicles</t>
            <div id="wrap" t-attf-class="wrapper">
                <div class="container">
                    <!-- Breadcrumb -->
                    <div class="row">
                        <form action="/page/product_vehicles" class="form-horizontal mt32 col-lg-8" method="post">
                            <div class="input-group" style="margin-left:60%;">
                                <div class="col-lg-6">
                                    <input type="text"
                                           name="search"
                                           class="form-control"
                                           placeholder="Search vehicles..."
                                           t-att-value="search"/>
                                </div>
                                <div class="col-lg-2">
                                    <button class="btn btn-primary">Search</button>
                                </div>
                            </div>
                            <input type="hidden"
                                   name="csrf_token"
                                   t-att-value="request.csrf_token()"/>
                        </form>
                    </div>
                    <br/>
                    <section>
                        <t t-if="vehicles">
                            <div class="row">
                                <t t-foreach="vehicles" t-as="vehicle">
                                    <div class="card border-0 col-lg-3 col-md-6 mb-4 text-center vehicle_item">
                                        <a t-att-href="'/vehicle/%s' % vehicle.id">
                                            <t t-if="vehicle.image_ids">
                                                <img class="card-img-top img-fluid vehicle_item_image"
                                                     t-att-src="vehicle.image_ids[0].url"
                                                     t-att-alt="vehicle.name"/>
                                            </t>
                                            <t t-else="">
                                                <img class="card-img-top img-fluid vehicle_item_image"
                                                     src="/web/static/src/img/placeholder.png"
                                                     alt="No image"/>
                                            </t>
                                            <div class="card-body border-0">
                                                <h5 class="card-title">
                                                    <t t-esc="vehicle.name"/>
                                                </h5>
                                                <div class="badge badge-primary">
                                                    <t t-esc="vehicle.products_count"/>
                                                    pieces
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </t>
                            </div>
                        </t>
                        <t t-if="not vehicles">
                            <div class="text-center text-muted">
                                <h3 class="css_editable_display">Not found vehicles...</h3>
                                <t t-if="search">
                                    <p>Not found vehicles for the search: "<t t-esc="search"/>"
                                    </p>
                                    <a href="/page/product_vehicles" class="btn btn-secondary">Show all vehicles
                                    </a>
                                </t>
                            </div>
                        </t>
                    </section>
                </div>
            </div>
        </t>
    </template>

    <!-- Template for the vehicle detail page -->
    <template id="vehicle_detail_template" name="Vehicle Detail">
        <t t-call="website.layout">
            <div id="wrap" class="wrapper">
                <div class="container">
                    <!-- Breadcrumb -->
                    <div class="row mb-3">
                        <ol class="breadcrumb bg-transparent">
                            <li class="breadcrumb-item">
                                <a href="/">Home</a>
                            </li>
                            <li class="breadcrumb-item">
                                <a href="/page/product_vehicles">Vehicles</a>
                            </li>
                            <li class="breadcrumb-item active" t-esc="vehicle.name"/>
                        </ol>
                    </div>

                    <!-- Vehicle Information -->
                    <div class="row mt-4">
                        <div class="col-lg-6">
                             <t t-if="vehicle.urls_imgs">
                                <img t-att-src="vehicle.urls_imgs.split()[0]"
                                     class="d-block w-100 img-fluid rounded shadow"
                                     t-att-alt="vehicle.name"/>
                            </t>
                            <t t-elif="vehicle.image_ids">
                                <div id="vehicleCarousel" class="carousel slide" data-bs-ride="carousel">
                                    <div class="carousel-inner">
                                        <t t-foreach="vehicle.image_ids" t-as="img" t-foreach-index="i">
                                            <div t-att-class="'carousel-item %s' % ('active' if i == 0 else '')">
                                                <img t-att-src="img.url"
                                                     class="d-block w-100 img-fluid rounded shadow"
                                                     t-att-alt="vehicle.name"/>
                                            </div>
                                        </t>
                                    </div>
                                    <a class="carousel-control-prev" href="#vehicleCarousel" role="button"
                                       data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    </a>
                                    <a class="carousel-control-next" href="#vehicleCarousel" role="button"
                                       data-bs-slide="next">
                                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    </a>
                                </div>
                            </t>
                            <t t-else="">
                                <img src="/web/static/src/img/placeholder.png"
                                     class="d-block w-100 img-fluid rounded shadow" alt="No image"/>
                            </t>
                        </div>

                        <!-- Information about the vehicle -->
                        <div class="col-md-6">
                            <h1 t-field="vehicle.name"/>
                            <div class="my-4" t-field="vehicle.description"/>
                            <div class="alert alert-info">
                                <i class="fa fa-info-circle"/>
                                <span t-esc="vehicle.products_count"/>
                                available pieces
                            </div>
                            <a t-att-href="'/contactus?subject=%s' % ('Query about ' + vehicle.name)"
                               class="btn btn-primary o_btn_action mt-4">
                                <i class="fa fa-envelope me-2"></i>
                                Request information
                            </a>
                        </div>
                    </div>


                    <!-- Featured Parts List -->
                    <!-- Related products -->
                    <div class="mt-5 p-4" style="background-color: #faf7f7; border-radius: 10px;">
                        <h4 class="mb-4">Related Pieces</h4>
                        <div class="container oe_website_sale">
                            <div class="row">
                                <div class="col-12">
                                    <div t-if="vehicle.product_ids" class="o_wsale_products_grid_table_wrapper">
                                        <section class="o_wsale_products_grid_table grid"
                                                 t-attf-style="--o-wsale-products-grid-gap: 0.5rem; --o-wsale-ppr: 4;">
                                            <t t-foreach="vehicle.product_ids" t-as="product">
                                                <div class="oe_product g-col-6 g-col-md-4 g-col-lg-3">
                                                    <div class="o_wsale_product_grid_wrapper position-relative h-100">
                                                        <form action="/shop/cart/update" method="post" class="h-100">
                                                            <input type="hidden" name="csrf_token"
                                                                   t-att-value="request.csrf_token()"/>
                                                            <div class="card h-100">
                                                                <!-- Product image -->
                                                                <div
                                                                    class="o_wsale_product_image position-relative flex-grow-0">
                                                                    <a t-att-href="'/shop/product/%s' % product.id"
                                                                       class="d-block h-100">
                                                                        <img t-if="product.image_1920"
                                                                             t-att-src="'/web/image/product.template/%s/image_1920' % product.id"
                                                                             t-att-alt="product.name"
                                                                             class="img-fluid h-100 w-100"
                                                                             style="object-fit: contain; max-height: 200px;"/>
                                                                    </a>
                                                                </div>
                                                                <!-- Product information -->
                                                                <div
                                                                    class="card-body d-flex flex-column justify-content-between p-2">
                                                                    <div>
                                                                        <h6 class="card-title mb-0">
                                                                            <a t-att-href="'/shop/product/%s' % product.id"
                                                                               t-field="product.name"
                                                                               class="text-decoration-none"/>
                                                                        </h6>
                                                                    </div>
                                                                    <div
                                                                        class="d-flex justify-content-between align-items-center mt-2">
                                                                        <div class="product_price">
                                                                            <span t-field="product.list_price"
                                                                                  t-options='{"widget": "monetary"}'
                                                                                  class="fw-bold"/>
                                                                        </div>
                                                                        <a t-att-href="'/shop/product/%s' % product.id"
                                                                           class="btn btn-primary o_btn_action mt-0">
                                                                            View
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </t>
                                        </section>
                                    </div>
                                    <div t-else="" class="text-center text-muted py-4">
                                        <h3 class="css_editable_display">No related parts available</h3>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- CSS Style -->
    <record id="assets_frontend" model="ir.asset">
        <field name="name">Vehicle Frontend Assets</field>
        <field name="bundle">web.assets_frontend</field>
        <field name="path">
            /desguace_website_sale_product_vehicle/static/src/scss/desguace_website_sale_product_vehicle.scss
        </field>
    </record>


    <!-- This view is used to create and edit vehicle records -->
    <record id="product_vehicle_form_view" model="ir.ui.view">
        <field name="name">product.vehicle.form</field>
        <field name="model">product.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle Products">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_products" type="object"
                                icon="fa-cubes">
                            <field name="products_count" widget="statinfo" string="Products"/>
                        </button>
                        <button class="oe_stat_button" name="website_publish_button" type="object"
                                icon="fa-globe">
                            <field name="is_published" widget="website_publish_button"/>
                        </button>
                    </div>

                    <group>
                        <group name="basic_info" string="Basic Information">
                            <field name="name" placeholder="Insert vehicle name"/>
                            <field name="description"/>
                            <field name="website_ribbon_id"/>
                            <field name="products_count" readonly="1"/>
                            <field name="is_published"/>
                        </group>

                        <group name="metasync_info" string="Metasync Information">
                            <field name="id_local"/>
                            <field name="id_empresa"/>
                            <field name="fecha_mod"/>
                            <field name="codigo"/>
                            <field name="estado"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="vehicle_data" string="Vehicle Data">
                            <group>
                                <group name="physical_data" string="Physical Data">
                                    <field name="bastidor"/>
                                    <field name="matricula"/>
                                    <field name="color"/>
                                    <field name="kilometraje"/>
                                    <field name="anyo_vehiculo"/>
                                    <field name="codigo_motor"/>
                                    <field name="codigo_cambio"/>
                                    <field name="observaciones"/>
                                </group>

                                <group name="brand_model" string="Brand &amp; Model">
                                    <field name="cod_marca"/>
                                    <field name="nombre_marca"/>
                                    <field name="cod_modelo"/>
                                    <field name="nombre_modelo"/>
                                    <field name="cod_version"/>
                                    <field name="nombre_version"/>
                                    <field name="tipo_version"/>
                                </group>
                            </group>
                        </page>

                        <page name="technical_specs" string="Technical Specifications">
                            <group>
                                <group name="engine_specs" string="Engine Specifications">
                                    <field name="combustible"/>
                                    <field name="tipos_motor"/>
                                    <field name="potencia_hp"/>
                                    <field name="potencia_kw"/>
                                    <field name="cilindrada"/>
                                    <field name="alimentacion"/>
                                </group>

                                <group name="vehicle_specs" string="Vehicle Specifications">
                                    <field name="puertas"/>
                                    <field name="anyo_inicio"/>
                                    <field name="anyo_fin"/>
                                    <field name="transmision"/>
                                    <field name="num_marchas"/>
                                </group>
                            </group>

                            <group>
                                <group name="additional_codes" string="Additional Codes">
                                    <field name="rv_code"/>
                                    <field name="ktype"/>
                                </group>

                                <group name="images_urls" string="Image URLs">
                                    <field name="urls_imgs" widget="text"/>
                                </group>
                            </group>
                        </page>

                        <page name="images" string="Images">
                            <group name="product_template_images" string="Images of vehicle">
                                <field name="image_ids" widget="many2many_kanban" options="{'no_create': True}"
                                       string="Vehicle Images">
                                    <kanban>
                                        <templates>
                                            <t t-name="card">
                                                <div style="width: 160px; margin: auto;">
                                                    <t t-if="record.url and record.url.value">
                                                        <img t-att-src="record.url.value" alt="Vehicle Image"
                                                             style="width:150px; height:150px; object-fit:cover; border-radius:8px;"/>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="o_kanban_image_placeholder"
                                                             style="width:150px; height:150px; display:flex; align-items:center; justify-content:center;">
                                                            <i class="fa fa-image fa-2x text-muted"/>
                                                        </div>
                                                    </t>
                                                </div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view for product.vehicle - Updated with more fields -->
    <record id="product_vehicle_list_view" model="ir.ui.view">
        <field name="name">product.vehicle.list</field>
        <field name="model">product.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="id_local"/>
                <field name="nombre_marca"/>
                <field name="nombre_modelo"/>
                <field name="anyo_vehiculo"/>
                <field name="matricula"/>
                <field name="products_count"/>
                <field name="estado"/>
                <field name="website_published" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Search view for product.vehicle -->
    <record id="product_vehicle_search_view" model="ir.ui.view">
        <field name="name">product.vehicle.search</field>
        <field name="model">product.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="id_local"/>
                <field name="bastidor"/>
                <field name="matricula"/>
                <field name="nombre_marca"/>
                <field name="nombre_modelo"/>
                <field name="codigo"/>
                <filter string="Published" name="published" domain="[('is_published', '=', True)]"/>
                <filter string="Unpublished" name="unpublished" domain="[('is_published', '=', False)]"/>
                <filter string="With Metasync ID" name="with_metasync_id" domain="[('id_local', '!=', False)]"/>
                <filter string="Without Metasync ID" name="without_metasync_id" domain="[('id_local', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Brand" name="group_by_brand" domain="[]" context="{'group_by': 'nombre_marca'}"/>
                    <filter string="Model" name="group_by_model" domain="[]" context="{'group_by': 'nombre_modelo'}"/>
                    <filter string="Year" name="group_by_year" domain="[]" context="{'group_by': 'anyo_vehiculo'}"/>
                    <filter string="State" name="group_by_state" domain="[]" context="{'group_by': 'estado'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Kanban view for product.vehicle -->
    <record id="product_vehicle_kanban_view" model="ir.ui.view">
        <field name="name">product.vehicle.kanban</field>
        <field name="model">product.vehicle</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name"/>
                <field name="id_local"/>
                <field name="nombre_marca"/>
                <field name="nombre_modelo"/>
                <field name="anyo_vehiculo"/>
                <field name="products_count"/>
                <field name="product_image_ids"/>
                <field name="is_published"/>
                <field name="image_ids"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <t t-if="record.image_ids and record.image_ids.value and record.image_ids.value.length > 0">
                                    <img class="card-img-top img-fluid vehicle_item_image"
                                         t-att-src="record.image_ids.value[0].url"
                                         t-att-alt="record.name.value"/>
                                </t>
                                <t t-else="">
                                    <div class="o_kanban_image_placeholder">
                                        <i class="fa fa-car fa-3x text-muted"/>
                                    </div>
                                </t>
                            </div>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <t t-esc="record.name.value"/>
                                        </strong>
                                        <t t-if="record.id_local.value">
                                            <small class="text-muted">(ID:<t t-esc="record.id_local.value"/>)
                                            </small>
                                        </t>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <t t-if="record.nombre_marca.value">
                                        <div>
                                            <strong>Brand:</strong>
                                            <t t-esc="record.nombre_marca.value"/>
                                        </div>
                                    </t>
                                    <t t-if="record.nombre_modelo.value">
                                        <div>
                                            <strong>Model:</strong>
                                            <t t-esc="record.nombre_modelo.value"/>
                                        </div>
                                    </t>
                                    <t t-if="record.anyo_vehiculo.value">
                                        <div>
                                            <strong>Year:</strong>
                                            <t t-esc="record.anyo_vehiculo.value"/>
                                        </div>
                                    </t>
                                    <div class="badge badge-info">
                                        <t t-esc="record.products_count.value"/>
                                        products
                                    </div>
                                </div>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <t t-if="record.is_published.value">
                                        <span class="badge badge-success">Published</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge badge-secondary">Unpublished</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Updated window action to include kanban view -->
    <record id="action_product_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicle</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.vehicle</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_published': 1}</field>
    </record>

    <!-- Menu item for the vehicle -->
    <menuitem id="menu_product_vehicle"
              name="Vehicles"
              action="desguace_website_sale_product_vehicle.action_product_vehicle"
              parent="website_sale.menu_ecommerce"
              groups="base.group_user"
    />
</odoo>
