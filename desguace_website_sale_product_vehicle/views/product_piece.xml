<odoo>
    <template id="product_images_gallery" inherit_id="website_sale.product" name="Product Images Gallery">
        <xpath expr="//div[@id='product_details']" position="after">
            <section class="container mt-4">
                <h4>Imágenes adicionales</h4>
                <div t-if="product and product.product_image_ids" class="row">
                    <t t-foreach="product.product_image_ids" t-as="img">
                        <div class="col-6 col-md-3 mb-3">
                            <img t-att-src="'/web/image/' + 'product.image.custom' + '/' + str(img.id) + '/image_1920'"
     class="img img-fluid" t-att-alt="img.name"/>

                        </div>
                    </t>
                </div>
                <div t-else="" class="alert alert-info">
                    No hay imágenes adicionales para este producto.
                </div>
            </section>
        </xpath>
    </template>
</odoo>
